{
  "name": "launchboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "0.45.4",
    "jose": "^5.9.6",
    "motion": "^12.43.0",
    "next": "^15.5.28",
    "pg": "^8.13.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "stripe": "^17.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
